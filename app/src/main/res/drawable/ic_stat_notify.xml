<?xml version="1.0" encoding="utf-8"?>
<!--
    状态栏通知小图标：系统只取 alpha 蒙版，必须是纯白单色矢量图。
    不能复用 @mipmap/ic_launcher（彩色启动图标作 small icon 会被压成白块）。
    图形沿用启动图标的「时钟」语义。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,4 A8,8 0 1,1 12,20 A8,8 0 1,1 12,4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M12,12 L12,7.5 M12,12 L15.5,13.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,11 A1,1 0 1,1 12,13 A1,1 0 1,1 12,11"
        android:fillColor="#FFFFFFFF" />
</vector>
