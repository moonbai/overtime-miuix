<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        权限梳理（2026-11-07，minSdk 26→33 + Android 17 适配套件）：
        - 新增 ACCESS_LOCAL_NETWORK：Android 17（targetSdk≥37）访问局域网（WebDAV 备份 / MCP 局域网接入）必需，
          未授权时系统 BPF 静默丢包；MainActivity 启动时运行时申请（仅 API 37+）
        - 删除 READ/WRITE_EXTERNAL_STORAGE：备份导入导出走 SAF（CreateDocument/OpenDocument），不需要存储权限；
          且 minSdk 33 下两者均已废弃
        - 删除 POST_NOTIFICATIONS：全代码无任何 NotificationManager/notify 调用（推送为服务端通道，不发系统通知）
        - 删除 tools:overrideLibrary：minSdk 33 与 miuix-blur AAR minSdk 33 齐平，不再需要覆盖
        - 保留 READ/WRITE_CALENDAR：日历同步，CalendarSettingsPage 已有 RequestMultiplePermissions 运行时申请
        - 保留 REQUEST_INSTALL_PACKAGES：更新安装 APK（特殊权限，系统设置页授权）
        - 注：<service> 的 foregroundServiceType="dataSync" 已移除——该服务用 startService 启动、从未 startForeground，
          类型声明不生效；若将来改前台服务需同时补 FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC_TYPE 权限
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".OvertimeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OvertimeMiuix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OvertimeMiuix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".mcp.McpHostService"
            android:exported="false" />
    </application>

</manifest>
