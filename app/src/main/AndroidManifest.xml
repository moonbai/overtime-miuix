<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        权限梳理（minSdk 33 + Android 17 适配套件）：
        - 启动时一律不申请运行时权限：POST_NOTIFICATIONS / ACCESS_LOCAL_NETWORK 只在用户
          主动启用 MCP 服务、WebDAV 云端备份等对应功能开关的那一刻按需请求，见
          FeaturePermissions.kt 与各功能设置页。未开启相关功能时启动流程零弹窗。
        - ACCESS_LOCAL_NETWORK：Android 17（targetSdk≥37）访问局域网（WebDAV 备份 / MCP
          局域网接入）必需，未授权时系统 BPF 静默丢包；仅 API 37+ 请求
        - 删除 READ/WRITE_EXTERNAL_STORAGE：备份导入导出走 SAF（CreateDocument/OpenDocument），
          不需要存储权限；且 minSdk 33 下两者均已废弃
        - 保留 READ/WRITE_CALENDAR：日历同步，CalendarSettingsPage 已有 RequestMultiplePermissions
          运行时申请，同样只在启用日历同步时触发
        - 保留 REQUEST_INSTALL_PACKAGES：更新安装 APK（特殊权限，系统设置页授权）
        - MCP 服务为前台服务（startForegroundService + startForeground），Android 14+ 要求声明
          foregroundServiceType 与对应权限，POST_NOTIFICATIONS 用于显示常驻通知
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".OvertimeApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OvertimeMiuix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OvertimeMiuix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".mcp.McpHostService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
